{
  "name": "with-svelte",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "clean": "turbo run clean",
    "check-types": "turbo run check-types",
    "dev": "turbo run dev",
    "format": "prettier --write .",
    "lint": "turbo run lint",
